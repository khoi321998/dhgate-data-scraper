{
    "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
    "actorSpecification": 1,
    "fields": {},
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": ["url", "captureMode", "success", "errorCode", "product.title", "extraction.status"]
            },
            "display": {
                "component": "table",
                "properties": {
                    "url": {
                        "label": "URL",
                        "format": "link"
                    },
                    "captureMode": {
                        "label": "Mode",
                        "format": "text"
                    },
                    "success": {
                        "label": "Success",
                        "format": "boolean"
                    },
                    "errorCode": {
                        "label": "Error",
                        "format": "text"
                    },
                    "product.title": {
                        "label": "Title",
                        "format": "text"
                    },
                    "extraction.status": {
                        "label": "Extraction",
                        "format": "text"
                    }
                }
            }
        },
        "extractionHealth": {
            "title": "Extraction health",
            "description": "Which expected fields came back absent. A row that is not `ok` usually means a markup change broke a selector.",
            "transformation": {
                "fields": [
                    "url",
                    "captureMode",
                    "extraction.status",
                    "extraction.missingFields",
                    "extraction.checkedFields"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "url": {
                        "label": "URL",
                        "format": "link"
                    },
                    "captureMode": {
                        "label": "Mode",
                        "format": "text"
                    },
                    "extraction.status": {
                        "label": "Status",
                        "format": "text"
                    },
                    "extraction.missingFields": {
                        "label": "Missing fields",
                        "format": "array"
                    },
                    "extraction.checkedFields": {
                        "label": "Fields checked",
                        "format": "number"
                    }
                }
            }
        }
    }
}
